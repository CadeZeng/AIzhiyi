{
  "name": "ai-translator",
  "productName": "AI智译",
  "version": "1.0.2",
  "description": "Vibe Coding 辅助翻译与提示词 - Windows 桌面应用",
  "author": "AI智译",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "gen:icon": "powershell -ExecutionPolicy Bypass -File generate-icon.ps1",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64 --publish never",
    "build:nsis": "electron-builder --win nsis --x64 --publish never",
    "build:dir": "electron-builder --win --dir --x64 --publish never",
    "dist:gh": "node scripts/publish.js",
    "dist:gh:direct": "electron-builder --win --x64 --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aizhiyi.translator",
    "productName": "AI智译",
    "copyright": "Copyright © 2026 AI智译",
    "afterPack": "./scripts/afterPack-icon.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "overlay.html",
      "result.html",
      "inplace.html",
      "electron/**/*",
      "package.json",
      "build/icon.ico",
      "build/icon.png",
      "build/icon-16.png"
    ],
    "extraResources": [
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon-16.png",
        "to": "icon-16.png"
      },
      {
        "from": "electron/helpers",
        "to": "helpers"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "CadeZeng",
        "repo": "AIzhiyi",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AI智译-Setup-${version}.${ext}",
      "publisherName": "AI智译",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false,
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI智译",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "2052"
    },
    "portable": {
      "artifactName": "AI智译-${version}-Portable.${ext}"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
